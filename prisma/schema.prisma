generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id           String   @id @default(cuid())
  clerkId      String?  @unique  // Clerk Auth User ID
  email        String   @unique
  name         String
  avatar       String?
  bio          String?
  role         String   @default("USER")  // USER | ADMIN
  isVerified   Boolean  @default(true)    // Clerk handles verification
  xpPoints     Int      @default(0)
  streakDays   Int      @default(0)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  coupleAsUser1     Couple[]        @relation("CoupleUser1")
  coupleAsUser2     Couple[]        @relation("CoupleUser2")
  sentInvites       CoupleInvite[]  @relation("InviteSender")
  receivedInvites   CoupleInvite[]  @relation("InviteReceiver")
  sentMessages      Message[]       @relation("MessageSender")
  memories          Memory[]
  moods             MoodEntry[]
  notes             Note[]
  expenses          Expense[]
  calendarEvents    CalendarEvent[]
  badges            UserBadge[]
  xpLogs            XPLog[]
  pushSubscriptions PushSubscription[]
  // New feature relations
  pokesSent         Poke[]          @relation("PokeSender")
  pokesReceived     Poke[]          @relation("PokeReceiver")
  questionAnswers   QuestionAnswer[]
  goals             Goal[]
  journalEntries    JournalEntry[]
  timeCapsules      TimeCapsule[]

  @@index([email])
  @@index([clerkId])
}

// ============================================================
// COUPLE SYSTEM
// ============================================================

model Couple {
  id           String   @id @default(cuid())
  user1Id      String
  user2Id      String
  user1        User     @relation("CoupleUser1", fields: [user1Id], references: [id])
  user2        User     @relation("CoupleUser2", fields: [user2Id], references: [id])
  theme        String   @default("default")
  anniversaryDate DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  messages        Message[]
  memories        Memory[]
  moods           MoodEntry[]
  notes           Note[]
  todos           TodoItem[]
  expenses        Expense[]
  events          CalendarEvent[]
  // New feature relations
  pokes           Poke[]
  questionAnswers QuestionAnswer[]
  goals           Goal[]
  journalEntries  JournalEntry[]
  timeCapsules    TimeCapsule[]
  gameSessions    GameSession[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model CoupleInvite {
  id          String       @id @default(cuid())
  senderId    String
  receiverId  String?
  receiverEmail String
  code        String       @unique @default(cuid())
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime     @default(now())

  sender   User  @relation("InviteSender", fields: [senderId], references: [id])
  receiver User? @relation("InviteReceiver", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([code])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

// ============================================================
// CHAT
// ============================================================

model Message {
  id         String   @id @default(cuid())
  coupleId   String
  senderId   String
  content    String
  type       MessageType @default(TEXT)
  mediaUrl   String?
  reaction   String?
  replyToId  String?
  seenAt     DateTime?
  createdAt  DateTime @default(now())

  couple   Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  sender   User     @relation("MessageSender", fields: [senderId], references: [id])
  replyTo  Message? @relation("MessageReply", fields: [replyToId], references: [id])
  replies  Message[] @relation("MessageReply")

  @@index([coupleId])
  @@index([senderId])
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  STICKER
  FILE
}

// ============================================================
// MEMORIES
// ============================================================

model Memory {
  id          String   @id @default(cuid())
  coupleId    String
  createdById String
  title       String
  caption     String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  couple    Couple  @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])
  photos    MemoryPhoto[]

  @@index([coupleId])
}

model MemoryPhoto {
  id        String @id @default(cuid())
  memoryId  String
  url       String
  publicId  String
  createdAt DateTime @default(now())

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
}

// ============================================================
// MOOD TRACKER
// ============================================================

model MoodEntry {
  id        String   @id @default(cuid())
  coupleId  String
  userId    String
  mood      String
  emoji     String
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  couple Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([coupleId])
  @@index([userId])
}

// ============================================================
// NOTES & TODOS
// ============================================================

model Note {
  id        String   @id @default(cuid())
  coupleId  String
  createdById String
  title     String
  content   String
  color     String   @default("#d946ef")
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  couple    Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([coupleId])
}

model TodoItem {
  id        String   @id @default(cuid())
  coupleId  String
  title     String
  isDone    Boolean  @default(false)
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  couple Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@index([coupleId])
}

// ============================================================
// EXPENSES
// ============================================================

model Expense {
  id          String          @id @default(cuid())
  coupleId    String
  paidById    String
  title       String
  amount      Float
  category    ExpenseCategory @default(OTHER)
  splitType   SplitType       @default(EQUAL)
  note        String?
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())

  couple  Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  paidBy  User   @relation(fields: [paidById], references: [id])

  @@index([coupleId])
}

enum ExpenseCategory {
  FOOD
  TRAVEL
  ENTERTAINMENT
  SHOPPING
  HEALTH
  UTILITIES
  OTHER
}

enum SplitType {
  EQUAL
  FULL_ME
  FULL_PARTNER
}

// ============================================================
// CALENDAR
// ============================================================

model CalendarEvent {
  id          String    @id @default(cuid())
  coupleId    String
  createdById String
  title       String
  description String?
  date        DateTime
  isRecurring Boolean   @default(false)
  eventType   EventType @default(OTHER)
  createdAt   DateTime  @default(now())

  couple    Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([coupleId])
}

enum EventType {
  ANNIVERSARY
  BIRTHDAY
  DATE
  TRIP
  MILESTONE
  OTHER
}

// ============================================================
// GAMIFICATION
// ============================================================

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  icon        String
  rarity      BadgeRarity @default(COMMON)
  xpReward    Int         @default(50)
  createdAt   DateTime    @default(now())

  users UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

enum BadgeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

model XPLog {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

// ============================================================
// POKE
// ============================================================

model Poke {
  id        String   @id @default(cuid())
  coupleId  String
  fromId    String
  toId      String
  emoji     String   @default("👉")
  message   String?
  seenAt    DateTime?
  createdAt DateTime @default(now())

  couple Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  from   User   @relation("PokeSender",   fields: [fromId], references: [id])
  to     User   @relation("PokeReceiver", fields: [toId],   references: [id])

  @@index([coupleId])
  @@index([toId])
}

// ============================================================
// DAILY QUESTION
// ============================================================

model DailyQuestion {
  id        String   @id @default(cuid())
  question  String
  category  String   @default("GENERAL")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  answers QuestionAnswer[]
}

model QuestionAnswer {
  id         String   @id @default(cuid())
  coupleId   String
  userId     String
  questionId String
  answer     String   @db.Text
  date       DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  createdAt  DateTime @default(now())

  couple   Couple        @relation(fields: [coupleId],   references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId],     references: [id])
  question DailyQuestion @relation(fields: [questionId], references: [id])

  @@unique([userId, questionId, date])
  @@index([coupleId])
  @@index([userId])
}

// ============================================================
// GOALS / BUCKET LIST
// ============================================================

model Goal {
  id          String       @id @default(cuid())
  coupleId    String
  createdById String
  title       String
  description String?
  category    GoalCategory @default(ADVENTURE)
  emoji       String       @default("🎯")
  targetDate  DateTime?
  isCompleted Boolean      @default(false)
  completedAt DateTime?
  photoUrl    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  couple    Couple @relation(fields: [coupleId],    references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([coupleId])
}

enum GoalCategory {
  ADVENTURE
  TRAVEL
  FOOD
  HEALTH
  RELATIONSHIP
  LEARNING
  OTHER
}

// ============================================================
// SHARED JOURNAL
// ============================================================

model JournalEntry {
  id          String   @id @default(cuid())
  coupleId    String
  createdById String
  title       String
  content     String   @db.Text
  mood        String?
  photoUrl    String?
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  couple    Couple @relation(fields: [coupleId],    references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([coupleId])
  @@index([createdAt])
}

// ============================================================
// TIME CAPSULE
// ============================================================

model TimeCapsule {
  id          String   @id @default(cuid())
  coupleId    String
  createdById String
  title       String
  message     String   @db.Text
  revealDate  DateTime
  isRevealed  Boolean  @default(false)
  revealedAt  DateTime?
  photoUrl    String?
  createdAt   DateTime @default(now())

  couple    Couple @relation(fields: [coupleId],    references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([coupleId])
  @@index([revealDate])
}

// ============================================================
// RELATIONSHIP GAME
// ============================================================

model GameSession {
  id        String     @id @default(cuid())
  coupleId  String
  gameType  GameType   @default(WOULD_YOU_RATHER)
  status    GameStatus @default(WAITING)
  score1    Int        @default(0)
  score2    Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  couple Couple      @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  rounds GameRound[]

  @@index([coupleId])
}

model GameRound {
  id        String   @id @default(cuid())
  sessionId String
  question  String
  optionA   String?
  optionB   String?
  answer1   String?
  answer2   String?
  createdAt DateTime @default(now())

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

enum GameType {
  WOULD_YOU_RATHER
  COUPLES_QUIZ
  TRUTH_OR_DARE
}

enum GameStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
}

