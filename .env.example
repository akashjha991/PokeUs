// Database
DATABASE_URL="postgresql://username:password@host:5432/pokeus?sslmode=require"

// JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
JWT_REFRESH_SECRET="your-refresh-token-secret-min-32-chars"

// App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PokeUs"

// Resend (OTP Emails) — https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

// Cloudinary (Image Uploads) — https://cloudinary.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_UPLOAD_PRESET="pokeus_uploads"

// Socket.IO (for production — set your Railway/Render URL)
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

// OTP Settings
OTP_EXPIRY_MINUTES="10"

// Supabase Authentication — https://supabase.com
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
