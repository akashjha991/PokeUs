# ─────────────────────────────────────────────────────────────────────────────
# PokeUs — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PokeUs"

# PostgreSQL Database (Neon, Supabase, or any PostgreSQL provider)
# https://neon.tech — free tier available
DATABASE_URL="postgresql://username:password@host:5432/pokeus?sslmode=require"

# Supabase Authentication — https://supabase.com
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Resend (Transactional Emails) — https://resend.com
# Free tier: 100 emails/day. Required for invite emails.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@yourdomain.com"
# Dev only: redirect all emails to this address (Resend sandbox restriction)
RESEND_TEST_EMAIL=""

# Cloudinary (Image Uploads) — https://cloudinary.com
# Free tier available. Create an unsigned upload preset named "pokeus_uploads".
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_UPLOAD_PRESET="pokeus_uploads"

# Web Push Notifications — https://web-push-codelab.glitch.me/
# Generate VAPID keys using: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
